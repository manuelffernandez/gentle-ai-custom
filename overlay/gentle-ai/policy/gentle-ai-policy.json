{
  "version": 1,
  "name": "gentle-ai-overlay-baseline",
  "description": "Runtime policy: OpenCode keep/prune baseline and global actor assignments, plus Codex preservation and command-surface constraints.",
  "maintenance": {
    "intent_file": "overlay/gentle-ai/policy/maintenance-intent.md",
    "state_file": "overlay/gentle-ai/state/upstream-state.json",
    "log_file": "overlay/gentle-ai/logs/update-log.md"
  },
  "upstream": {
    "repo_name": "gentle-ai",
    "orchestrator_prompt_path": "internal/assets/opencode/sdd-orchestrator.md"
  },
  "skills": {
    "keep": [
      "_shared",
      "chained-pr",
      "cognitive-doc-design",
      "comment-writer",
      "go-testing",
      "judgment-day",
      "skill-creator",
      "skill-improver",
      "skill-registry",
      "work-unit-commits"
    ],
    "prune": [
      "branch-pr",
      "issue-creation",
      "hermes-ephemeral-delegation",
      "sdd-apply",
      "sdd-archive",
      "sdd-design",
      "sdd-explore",
      "sdd-init",
      "sdd-onboard",
      "sdd-propose",
      "sdd-research",
      "sdd-spec",
      "sdd-tasks",
      "sdd-verify"
    ]
  },
  "opencode": {
    "config_path": "~/.config/opencode/opencode.json",
    "local_config_path": "~/.config/gentle-ai-custom/opencode-local-config.json",
    "base_orchestrator_key": "gentle-orchestrator",
    "orchestrator_agent_keys": [
      "gentle-orchestrator"
    ],
    "orchestrator_agent_prefixes": [
      "sdd-orchestrator"
    ]
  },
  "codex": {
    "preserve_unselected_skills": true,
    "render_commands": false
  }
}
