# Project-level npm baseline
# Commit this into the repo so Docker, CI, and all developers enforce the same policy.
#
# Conservative mode: block dependency lifecycle scripts entirely.
# npm also has a reviewed `allowScripts` policy plus `approve-scripts` and
# `strict-allow-scripts` in supported releases, but enforcement is advisory by
# default. Verify this exact CLI supports them before relying on that policy.
# Do not combine `ignore-scripts=true` with reviewed grants: ignore-scripts
# takes precedence and blocks those scripts too.
#
# If this project needs dependency build scripts, remove ignore-scripts only
# after reviewing the package.json allowScripts policy and enabling strict
# enforcement on every install path.

ignore-scripts=true
allow-git=none
# npm measures min-release-age in days (3 = 72 hours); pnpm uses minutes.
min-release-age=3
save-exact=true
